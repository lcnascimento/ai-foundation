#!/usr/bin/env python3
import os
import sys

args = sys.argv[1:]
if args[:2] != ["pr", "list"]:
    sys.exit(f"fake gh: unsupported command {args}")
branch, state = args[args.index("--head") + 1], args[args.index("--state") + 1]
path = os.path.join(os.environ["FAKE_GH_DIR"], state, f"{branch}.json")
print(open(path).read() if os.path.exists(path) else "[]")
